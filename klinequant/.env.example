# === KlineQuant 环境变量模板 ===
# 复制此文件为 .env 并填入实际值

# --- 系统 ---
KQ_MODE=paper                    # live / paper / backtest
KQ_LOG_LEVEL=INFO
KQ_TIMEZONE=UTC
KQ_DATA_DIR=./data

# --- Gateway ---
KQ_GATEWAY_HOST=127.0.0.1
KQ_GATEWAY_PORT=8000
KQ_JWT_SECRET=change-me-in-production

# --- ClickHouse ---
KQ_CH_HOST=localhost
KQ_CH_PORT=8123
KQ_CH_TCP_PORT=9000
KQ_CH_DATABASE=klinequant
KQ_CH_USERNAME=default
KQ_CH_PASSWORD=

# --- DuckDB ---
KQ_DUCKDB_PATH=./data/klinequant.duckdb

# --- Redis ---
KQ_REDIS_HOST=localhost
KQ_REDIS_PORT=6379
KQ_REDIS_DB=0

# --- 网络代理 ---
HTTP_PROXY=http://127.0.0.1:7897
HTTPS_PROXY=http://127.0.0.1:7897

# --- 交易所 API ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# --- 本地 MT5 市场源（市场源插件框架：终端未连接时该插件自动跳过） ---
# 全部可选：缺省时连接已登录运行的本机 MT5 终端；配置后由包拉起指定终端
MT5_TERMINAL_PATH=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
#MT5_POLL_INTERVAL=0.5                # 终端轮询间隔（秒，默认 0.5 与币安 K 线更新节奏对齐）

# --- 同花顺 A 股市场源（thsdk 协议 SDK：未配置时落游客模式，仅限开发） ---
# MAC 由账号自动生成，无需填写；协议逆向库仅限个人研究用途，勿对外分发
THS_USERNAME=
THS_PASSWORD=
#THS_POLL_INTERVAL=2.0                # 快照轮询间隔（秒，默认 2.0，官方限频 20ms/次内的保守值）

# --- 市场源插件开关（逗号分隔，缺省全部启用） ---
KQ_MARKET_SOURCES=binance,mt5,ths

# --- 告警 ---
ALERT_WEBHOOK_URL=
