# 强制所有文件使用 LF 换行（跨平台一致性）
* text=auto eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf

# YAML / TOML / JSON
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Shell / PowerShell
*.sh text eol=lf
*.ps1 text eol=lf

# Frontend
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf

# Binary
*.duckdb binary
*.parquet binary
*.png binary
*.ico binary
